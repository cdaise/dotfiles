# credit http://archive.today/2026.03.26-230516/https://blog.gitbutler.com/how-git-core-devs-configure-git%23global-ignore-file
[user]
	name = {{ .name }}
	email = {{ .email }}
	username = {{ .username }}
 signingKey = 567CEB6B
[core]
	editor = nvim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
	pager = bat -l man -p
  autocrlf = false
[commit]
  verbose = true
  gpgsign = true
[branch]
  sort = -committerdate
[column]
  ui = auto
[tag]
  sort = -version:refname
[init]
  defaultBranch = main
[checkout]
  defaultRemote = origin
[diff]
  algorithm = histogram
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
[maintenance]
  auto = true
  strategy = incremental
[status]
  branch = true
[rerere]
  enabled = true
  autoUpdate = true
[help]
  autocorrect = prompt
[alias]
  # credit http://archive.today/2025.07.26-010420/https://micahkepe.com/blog/gitconfig/
  graph = log --all --graph --decorate --oneline
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  ignore = "!gi() { local IFS=','; curl -sL https://www.toptal.com/developers/gitignore/api/\"$*\"; }; gi"
